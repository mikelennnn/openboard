<merge
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:id="@+id/suggestions_strip_wrapper"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:hapticFeedbackEnabled="false"
        android:soundEffectsEnabled="false">
        <!-- Provide audio and haptic feedback by ourselves based on the keyboard settings.
             We just need to ignore the system's audio and haptic feedback settings. -->
        <ImageButton
            android:id="@+id/suggestions_strip_translate_key"
            android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
            android:layout_height="fill_parent"
            android:src="@drawable/ic_translate_globe"
            android:contentDescription="TRADUCIR"
            style="?attr/suggestionWordStyle" />
        <ImageButton
            android:id="@+id/suggestions_strip_font_key"
            android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
            android:layout_height="fill_parent"
            android:src="@drawable/ic_font_pencil"
            android:contentDescription="FUENTES"
            style="?attr/suggestionWordStyle" />
        <ImageButton
            android:id="@+id/suggestions_strip_symbols_key"
            android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
            android:layout_height="fill_parent"
            android:src="@drawable/ic_symbols_star"
            android:contentDescription="SIMBOLOS"
            style="?attr/suggestionWordStyle" />
        <ImageButton
            android:id="@+id/suggestions_strip_other_key"
            android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
            android:layout_height="fill_parent"
            android:layout_weight="0"
            style="?attr/suggestionWordStyle"
            android:contentDescription="@string/more_keys_strip_description" />
        <!-- Provide audio and haptic feedback by ourselves based on the keyboard settings.
             We just need to ignore the system's audio and haptic feedback settings. -->
        <LinearLayout
            android:id="@+id/suggestions_strip"
            android:orientation="horizontal"
            android:maxWidth="100dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hapticFeedbackEnabled="false"
            android:soundEffectsEnabled="false" />
        <HorizontalScrollView
            android:layout_width="220dp"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <ImageButton
                    android:id="@+id/suggestions_strip_voice_key"
                    android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
                    android:layout_height="fill_parent"
                    android:contentDescription="@string/spoken_description_mic"
                    style="?attr/suggestionWordStyle" />
                <ImageButton
                    android:id="@+id/suggestions_strip_clipboard_key"
                    android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
                    android:layout_height="fill_parent"
                    style="?attr/suggestionWordStyle" />
                <TextView
                    android:id="@+id/suggestions_strip_ai_key"
                    android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
                    android:layout_height="fill_parent"
                    android:gravity="center"
                    android:text="IA"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:contentDescription="IA"
                    style="?attr/suggestionWordStyle" />
                <ImageButton
                    android:id="@+id/suggestions_strip_correct_key"
                    android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
                    android:layout_height="fill_parent"
                    android:src="@drawable/ic_correct_chat"
                    android:contentDescription="CORREGIR"
                    style="?attr/suggestionWordStyle" />
                <ImageButton
                    android:id="@+id/suggestions_strip_rude_key"
                    android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
                    android:layout_height="fill_parent"
                    android:src="@drawable/ic_rude_burst"
                    android:contentDescription="GROSERO"
                    style="?attr/suggestionWordStyle" />
                <ImageButton
                    android:id="@+id/suggestions_strip_formal_key"
                    android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
                    android:layout_height="fill_parent"
                    android:src="@drawable/ic_formal_hat"
                    android:contentDescription="FORMAL"
                    style="?attr/suggestionWordStyle" />
                <ImageButton
                    android:id="@+id/suggestions_strip_romantic_key"
                    android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
                    android:layout_height="fill_parent"
                    android:src="@drawable/ic_romantic_heart"
                    android:contentDescription="ROMANTICO"
                    style="?attr/suggestionWordStyle" />
                <ImageButton
                    android:id="@+id/suggestions_strip_detail_key"
                    android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
                    android:layout_height="fill_parent"
                    android:src="@drawable/ic_detail_doc"
                    android:contentDescription="DETALLAR"
                    style="?attr/suggestionWordStyle" />
                <ImageButton
                    android:id="@+id/suggestions_strip_summarize_key"
                    android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
                    android:layout_height="fill_parent"
                    android:src="@drawable/ic_summarize_bolt"
                    android:contentDescription="RESUMIR"
                    style="?attr/suggestionWordStyle" />
                <ImageButton
                    android:id="@+id/suggestions_strip_emoji_key"
                    android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
                    android:layout_height="fill_parent"
                    android:src="@drawable/ic_emoji_smile"
                    android:contentDescription="EMOJIS"
                    style="?attr/suggestionWordStyle" />
                <ImageButton
                    android:id="@+id/suggestions_strip_sarcasm_key"
                    android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
                    android:layout_height="fill_parent"
                    android:src="@drawable/ic_sarcasm_wink"
                    android:contentDescription="SARCASMO"
                    style="?attr/suggestionWordStyle" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</merge>
